rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // group メンバーシップは groups/{gid}.memberUids を真実源とする。
    // get() は rule 評価ごとに read 1 を消費するが、20 人 x 月 1〜2 回スケールでは無視可能。
    function isGroupMember(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    function isGroupOwner(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid;
    }

    // users: 本人のみ自分のプロフィールを読書（groupIds 含む）
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // groups: メンバーのみ read。create は自分が ownerUid かつ memberUids が自分 1 人のみ。
    match /groups/{gid} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids.size() == 1
                    && request.resource.data.memberUids.hasOnly([request.auth.uid]);

      // owner はフル update（ただし ownerUid は不変）／非メンバーは「自分を memberUids に +1 追加」のみ／
      // 非 owner メンバーは「自分を memberUids から -1 除外」のみ。
      allow update: if (
        // owner update（name / memberUids 自由、ownerUid 不変）
        isSignedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
      ) || (
        // self-add（招待コード経由の参加）
        isSignedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        // self-leave（owner 以外のメンバーが自分を外す）
        isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid != resource.data.ownerUid
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
      );

      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.ownerUid;
    }

    // groupJoinCodes: 認証済みなら read 可（コード文字列を URL から踏める前提）。
    // create はコード発行者が対象 group のメンバー。update は usesCount を +1 する形のみ。
    match /groupJoinCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.usesCount == 0
                    && isGroupMember(request.resource.data.gid);

      allow update: if isSignedIn()
                    && request.resource.data.gid == resource.data.gid
                    && request.resource.data.createdByUid == resource.data.createdByUid
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.maxUses == resource.data.maxUses
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.usesCount == resource.data.usesCount + 1
                    && resource.data.expiresAt.toMillis() > request.time.toMillis()
                    && (resource.data.maxUses == null
                        || request.resource.data.usesCount <= resource.data.maxUses);

      allow delete: if isSignedIn()
                    && isGroupOwner(resource.data.gid);
    }

    // structures: group メンバー全員が共有
    match /structures/{sid} {
      allow read, update, delete: if isGroupMember(resource.data.groupId);
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isGroupMember(request.resource.data.groupId);
    }

    // tournaments: read は認証済み（受付参加者向け）／write は group メンバー
    match /tournaments/{tid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isGroupMember(resource.data.groupId);

      // 参加者ドキュメント: 本人による自己作成／更新／取消を許容（Phase 2: 受付フロー）
      // Phase 4: update を「self: displayName のみ変更可」と「group メンバー: bust/seat 変更可」に分岐。
      match /players/{pid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && pid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.isBusted == false
                      && request.resource.data.tableNum == null
                      && request.resource.data.seatNum == null;
        // self-update: displayName のみ変更可。残りフィールドは immutable。
        // organizer-update: group メンバーなら bust/seat/lastMovedAt 変更可。uid と entryAt は immutable。
        // Phase 4 (M1 fix): organizer 経路でも tableNum / seatNum の型・範囲・整合性を rule で検証する。
        //   - 数値の場合は int 型 + 1〜MAX_TABLES (6) / 1〜MAX_SEATS_PER_TABLE (10) 範囲
        //   - tableNum と seatNum は同時 null か同時 int でなければならない（片方だけ設定不可）
        //
        // ⚠ DRIFT WARNING (L3): 以下の定数は rule 内ハードコード。drift を防ぐため、変更時は同期更新すること:
        //   - MAX_TABLES = 6 ↔ src/lib/services/seating/engine.ts の MAX_TABLES
        //   - MAX_SEATS_PER_TABLE = 10 ↔ src/lib/firebase/schemas/tournament.ts の seatsPerTable.max(10)
        // Cloud Functions 化（Phase 5+）で集約する場合はこの分散ロジックを廃止する。
        allow update: if isSignedIn()
                      && (
                        (
                          pid == request.auth.uid
                          && resource.data.uid == request.auth.uid
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.isBusted == resource.data.isBusted
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.bustedAt == resource.data.bustedAt
                          && request.resource.data.tableNum == resource.data.tableNum
                          && request.resource.data.seatNum == resource.data.seatNum
                          && request.resource.data.lastMovedAt == resource.data.lastMovedAt
                        )
                        ||
                        (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isGroupMember(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.isBusted is bool
                          && (
                            request.resource.data.tableNum == null
                            || (request.resource.data.tableNum is int
                                && request.resource.data.tableNum >= 1
                                && request.resource.data.tableNum <= 6)
                          )
                          && (
                            request.resource.data.seatNum == null
                            || (request.resource.data.seatNum is int
                                && request.resource.data.seatNum >= 1
                                && request.resource.data.seatNum <= 10)
                          )
                          && (
                            (request.resource.data.tableNum == null && request.resource.data.seatNum == null)
                            || (request.resource.data.tableNum != null && request.resource.data.seatNum != null)
                          )
                        )
                      );
        // self-delete（自己取消）と group メンバーによる owner-delete を許容。
        allow delete: if isSignedIn()
                      && (
                        pid == request.auth.uid
                        || (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isGroupMember(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                        )
                      );
      }

      // その他サブコレクションは group メンバーのみ書込可、認証済みユーザーは読取可
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
                     && exists(/databases/$(database)/documents/tournaments/$(tid))
                     && isGroupMember(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId);
      }
    }
  }
}
