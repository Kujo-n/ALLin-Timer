rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Phase 4.6: 3 階層ロール。group メンバーシップは groups/{gid} の 3 つの配列で判定。
    // get() は rule 評価ごとに read 1 を消費するが、20 人 x 月 1〜2 回スケールでは無視可能。
    // 同一評価内での同一 path の get() は cache される（Firebase の仕様）。
    function isGroupMember(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    function isOrganizer(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.organizerUids;
    }

    function isOwner(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.ownerUids;
    }

    // Phase 4.6.1: self-add 経路で「招待コードが有効で、この request 内で usesCount が +1 消費される」
    // ことを atomic に検証する。これがないと、認証済みユーザーが `updateDoc(groups/{gid}, { memberUids: arrayUnion })`
    // を直接呼び、招待コード validation を skip して任意の group に member として加入できてしまう（security.md 要件違反）。
    //
    // getAfter() により、同 request 内で groupJoinCodes/{code} の usesCount が +1 されることを強制する。
    // これは maxUses の rule 側 enforcement にも効く（後続の usesCount <= maxUses 検証と合わせる）。
    function hasValidJoinCodeConsumption(gid, code) {
      return exists(/databases/$(database)/documents/groupJoinCodes/$(code))
             && get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.gid == gid
             && get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.expiresAt.toMillis() > request.time.toMillis()
             && getAfter(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount
                == get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount + 1
             && (get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.maxUses == null
                 || getAfter(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount
                    <= get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.maxUses);
    }

    // users: 本人のみ自分のプロフィールを読書（groupIds 含む）
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // groups: メンバーのみ read。create は自分が唯一の owner/organizer/member。
    match /groups/{gid} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
                    && request.resource.data.ownerUids.size() == 1
                    && request.resource.data.ownerUids.hasOnly([request.auth.uid])
                    && request.resource.data.organizerUids.size() == 1
                    && request.resource.data.organizerUids.hasOnly([request.auth.uid])
                    && request.resource.data.memberUids.size() == 1
                    && request.resource.data.memberUids.hasOnly([request.auth.uid]);

      // owner はフル update（ownerUids が空になる変更は禁止、createdAt 不変）／
      // 非メンバーは「自分を memberUids に +1 追加、organizerUids / ownerUids は不変」のみ（招待コード加入）／
      // 非 owner メンバーは「自分を memberUids / organizerUids から -1 除外」のみ。
      allow update: if (
        // owner update（name / ロール配列 / memberUids / memberDisplayNames 自由、
        //   ただし ownerUids 空不可・createdAt 不変）
        isSignedIn()
        && request.auth.uid in resource.data.ownerUids
        && request.resource.data.ownerUids.size() >= 1
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        // self-add（招待コード経由の参加）— 一般メンバーとして加入。
        // Phase 4.6.1: request.resource.data.joinCodeId で参照される groupJoinCodes doc の
        // 有効性と「この request 内での usesCount +1 消費」を rule 側で強制する。
        // Phase 4.7: memberDisplayNames にも自分の entry を追加可能（他人の entry は不変）。
        //   値は 1〜15 文字の string に制限（UI 側のスマホ 1 行表示可能長に揃える）。
        //   diff 比較は両辺 .get(..., {}) で legacy doc（フィールド無し）でも evaluate 可能にする。
        isSignedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.uid in request.resource.data.organizerUids)
        && !(request.auth.uid in request.resource.data.ownerUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.organizerUids == resource.data.organizerUids
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.joinCodeId is string
        && hasValidJoinCodeConsumption(gid, request.resource.data.joinCodeId)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberDisplayNames[request.auth.uid] is string
        && request.resource.data.memberDisplayNames[request.auth.uid].size() >= 1
        && request.resource.data.memberDisplayNames[request.auth.uid].size() <= 15
      ) || (
        // self-leave（非 owner のみ）— 自分を memberUids / organizerUids から除外
        // organizerUids は「自分が含まれていれば 1 減、含まれていなければ不変」を厳密に enforce
        // （これを怠ると、自己脱退を偽装して他の organizer を降格できてしまう）。
        // Phase 4.7: memberDisplayNames からも自分の entry を削除する（他人の entry は不変）。
        //   両辺 .get(..., {}) で包むことで legacy doc（フィールド無し）でも deleteField() が通る。
        isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && !(request.auth.uid in resource.data.ownerUids)
        && !(request.auth.uid in request.resource.data.memberUids)
        && !(request.auth.uid in request.resource.data.organizerUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && (
          (
            request.auth.uid in resource.data.organizerUids
            && request.resource.data.organizerUids.size() == resource.data.organizerUids.size() - 1
            && resource.data.organizerUids.hasAll(request.resource.data.organizerUids)
          )
          ||
          (
            !(request.auth.uid in resource.data.organizerUids)
            && request.resource.data.organizerUids == resource.data.organizerUids
          )
        )
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('joinCodeId', null) == resource.data.get('joinCodeId', null)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
      ) || (
        // Phase 4.7: self-key displayName update — 既メンバーが自分の memberDisplayNames entry を更新。
        //   他フィールドは全て immutable にチェックし、map の差分は auth.uid キーに限定する。
        //   値は 1〜15 文字の string に制限（self-add と同じ）。
        //   両辺 .get(..., {}) で legacy doc 互換。
        isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.organizerUids == resource.data.organizerUids
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('joinCodeId', null) == resource.data.get('joinCodeId', null)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberDisplayNames[request.auth.uid] is string
        && request.resource.data.memberDisplayNames[request.auth.uid].size() >= 1
        && request.resource.data.memberDisplayNames[request.auth.uid].size() <= 15
      );

      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.ownerUids;
    }

    // groupJoinCodes: コード文字列を知るユーザーが `get` できる前提（URL 踏み経由の加入）。
    // Phase 4.6.1: `list` は明示的に禁止する。認証済みの任意ユーザーが全コード・全 gid を
    // 列挙できると、gid ベースの攻撃（groups self-add への不正加入）が trivial になる。
    // create は organizer のみ。update は usesCount を +1 する形のみ。
    match /groupJoinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.usesCount == 0
                    && isOrganizer(request.resource.data.gid);

      allow update: if isSignedIn()
                    && request.resource.data.gid == resource.data.gid
                    && request.resource.data.createdByUid == resource.data.createdByUid
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.maxUses == resource.data.maxUses
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.usesCount == resource.data.usesCount + 1
                    && resource.data.expiresAt.toMillis() > request.time.toMillis()
                    && (resource.data.maxUses == null
                        || request.resource.data.usesCount <= resource.data.maxUses);

      allow delete: if isSignedIn()
                    && isOwner(resource.data.gid);
    }

    // structures: read は group メンバー、write は organizer のみ
    match /structures/{sid} {
      allow read: if isGroupMember(resource.data.groupId);
      allow update, delete: if isOrganizer(resource.data.groupId);
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isOrganizer(request.resource.data.groupId);
    }

    // tournaments: read は認証済み（受付参加者向け）／write は organizer のみ
    match /tournaments/{tid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isOrganizer(request.resource.data.groupId);
      allow update, delete: if isOrganizer(resource.data.groupId);

      // 参加者ドキュメント: 本人による自己作成／更新／取消を許容（Phase 2: 受付フロー）
      // Phase 4: update を「self: displayName のみ変更可」と「organizer: bust/seat 変更可」に分岐。
      // Phase 4.6: organizer 経路は isOrganizer に強化（一般メンバーは他人を bust/seat できない）。
      match /players/{pid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && pid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.isBusted == false
                      && request.resource.data.tableNum == null
                      && request.resource.data.seatNum == null;
        // self-update: displayName のみ変更可。残りフィールドは immutable。
        // organizer-update: organizer なら bust/seat/lastMovedAt 変更可。uid と entryAt は immutable。
        // Phase 4 (M1 fix): organizer 経路でも tableNum / seatNum の型・範囲・整合性を rule で検証する。
        //   - 数値の場合は int 型 + 1〜MAX_TABLES (6) / 1〜MAX_SEATS_PER_TABLE (10) 範囲
        //   - tableNum と seatNum は同時 null か同時 int でなければならない（片方だけ設定不可）
        //
        // ⚠ DRIFT WARNING (L3): 以下の定数は rule 内ハードコード。drift を防ぐため、変更時は同期更新すること:
        //   - MAX_TABLES = 6 ↔ src/lib/services/seating/engine.ts の MAX_TABLES
        //   - MAX_SEATS_PER_TABLE = 10 ↔ src/lib/firebase/schemas/tournament.ts の seatsPerTable.max(10)
        // Cloud Functions 化（Phase 5+）で集約する場合はこの分散ロジックを廃止する。
        allow update: if isSignedIn()
                      && (
                        (
                          pid == request.auth.uid
                          && resource.data.uid == request.auth.uid
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.isBusted == resource.data.isBusted
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.bustedAt == resource.data.bustedAt
                          && request.resource.data.tableNum == resource.data.tableNum
                          && request.resource.data.seatNum == resource.data.seatNum
                          && request.resource.data.lastMovedAt == resource.data.lastMovedAt
                        )
                        ||
                        (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.isBusted is bool
                          && (
                            request.resource.data.tableNum == null
                            || (request.resource.data.tableNum is int
                                && request.resource.data.tableNum >= 1
                                && request.resource.data.tableNum <= 6)
                          )
                          && (
                            request.resource.data.seatNum == null
                            || (request.resource.data.seatNum is int
                                && request.resource.data.seatNum >= 1
                                && request.resource.data.seatNum <= 10)
                          )
                          && (
                            (request.resource.data.tableNum == null && request.resource.data.seatNum == null)
                            || (request.resource.data.tableNum != null && request.resource.data.seatNum != null)
                          )
                        )
                      );
        // self-delete（自己取消）と organizer による owner-delete を許容。
        allow delete: if isSignedIn()
                      && (
                        pid == request.auth.uid
                        || (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                        )
                      );
      }

      // その他サブコレクションは organizer のみ書込可、認証済みユーザーは読取可
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
                     && exists(/databases/$(database)/documents/tournaments/$(tid))
                     && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId);
      }
    }
  }
}
