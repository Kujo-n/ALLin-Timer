rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Phase 4.8 follow-up: 匿名ユーザー（signInAnonymously）を除外したサインイン判定。
    // UI は `RequireAuth(allowAnonymous=false)` で匿名を弾くが、SDK 直叩き攻撃を塞ぐため
    // Structure Templates のように「通常アカウント限定」の rule でのみ使う。
    // provider id は Firebase Auth 仕様: 匿名 = 'anonymous' / メール = 'password' /
    // Google = 'google.com' / メールリンク = 'emailLink'。
    function isSignedInNotAnon() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Phase 4.6: 3 階層ロール。group メンバーシップは groups/{gid} の 3 つの配列で判定。
    // get() は rule 評価ごとに read 1 を消費するが、20 人 x 月 1〜2 回スケールでは無視可能。
    // 同一評価内での同一 path の get() は cache される（Firebase の仕様）。
    function isGroupMember(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    function isOrganizer(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.organizerUids;
    }

    function isOwner(gid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/groups/$(gid))
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.ownerUids;
    }

    // Phase 4.8: グローバルなテンプレート管理者。`templateAdmins/{uid}` doc の存在で判定する。
    // rule 評価 1 回につき 1 read を消費するが、呼び出しは structureTemplates の delete 時のみ。
    function isTemplateAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/templateAdmins/$(request.auth.uid));
    }

    // Phase 4.6.1: self-add 経路で「招待コードが有効で、この request 内で usesCount が +1 消費される」
    // ことを atomic に検証する。これがないと、認証済みユーザーが `updateDoc(groups/{gid}, { memberUids: arrayUnion })`
    // を直接呼び、招待コード validation を skip して任意の group に member として加入できてしまう（security.md 要件違反）。
    //
    // getAfter() により、同 request 内で groupJoinCodes/{code} の usesCount が +1 されることを強制する。
    // これは maxUses の rule 側 enforcement にも効く（後続の usesCount <= maxUses 検証と合わせる）。
    function hasValidJoinCodeConsumption(gid, code) {
      return exists(/databases/$(database)/documents/groupJoinCodes/$(code))
             && get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.gid == gid
             && get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.expiresAt.toMillis() > request.time.toMillis()
             && getAfter(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount
                == get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount + 1
             && (get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.maxUses == null
                 || getAfter(/databases/$(database)/documents/groupJoinCodes/$(code)).data.usesCount
                    <= get(/databases/$(database)/documents/groupJoinCodes/$(code)).data.maxUses);
    }

    // users: 本人のみ自分のプロフィールを読書（groupIds 含む）
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // groups: メンバーのみ read。create は自分が唯一の owner/organizer/member。
    match /groups/{gid} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
                    && request.resource.data.ownerUids.size() == 1
                    && request.resource.data.ownerUids.hasOnly([request.auth.uid])
                    && request.resource.data.organizerUids.size() == 1
                    && request.resource.data.organizerUids.hasOnly([request.auth.uid])
                    && request.resource.data.memberUids.size() == 1
                    && request.resource.data.memberUids.hasOnly([request.auth.uid]);

      // owner はフル update（ownerUids が空になる変更は禁止、createdAt 不変）／
      // 非メンバーは「自分を memberUids に +1 追加、organizerUids / ownerUids は不変」のみ（招待コード加入）／
      // 非 owner メンバーは「自分を memberUids / organizerUids から -1 除外」のみ。
      allow update: if (
        // owner update（name / ロール配列 / memberUids / memberDisplayNames 自由、
        //   ただし ownerUids 空不可・createdAt 不変）
        isSignedIn()
        && request.auth.uid in resource.data.ownerUids
        && request.resource.data.ownerUids.size() >= 1
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        // self-add（招待コード経由の参加）— 一般メンバーとして加入。
        // Phase 4.6.1: request.resource.data.joinCodeId で参照される groupJoinCodes doc の
        // 有効性と「この request 内での usesCount +1 消費」を rule 側で強制する。
        // Phase 4.7: memberDisplayNames にも自分の entry を追加可能（他人の entry は不変）。
        //   値は 1〜15 文字の string に制限（UI 側のスマホ 1 行表示可能長に揃える）。
        //   diff 比較は両辺 .get(..., {}) で legacy doc（フィールド無し）でも evaluate 可能にする。
        // Phase 4.16: 全体の affectedKeys を `memberUids` / `organizerUids` / `joinCodeId` /
        //   `memberDisplayNames` のみに限定する。これがないと、招待コード経由の加入時に
        //   audioSettings / finishedTournamentCount など他フィールドも同時改竄できてしまう。
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'organizerUids', 'joinCodeId', 'memberDisplayNames'])
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.uid in request.resource.data.organizerUids)
        && !(request.auth.uid in request.resource.data.ownerUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.organizerUids == resource.data.organizerUids
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.joinCodeId is string
        && hasValidJoinCodeConsumption(gid, request.resource.data.joinCodeId)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberDisplayNames[request.auth.uid] is string
        && request.resource.data.memberDisplayNames[request.auth.uid].size() >= 1
        && request.resource.data.memberDisplayNames[request.auth.uid].size() <= 15
      ) || (
        // self-leave（非 owner のみ）— 自分を memberUids / organizerUids から除外
        // organizerUids は「自分が含まれていれば 1 減、含まれていなければ不変」を厳密に enforce
        // （これを怠ると、自己脱退を偽装して他の organizer を降格できてしまう）。
        // Phase 4.7: memberDisplayNames からも自分の entry を削除する（他人の entry は不変）。
        //   両辺 .get(..., {}) で包むことで legacy doc（フィールド無し）でも deleteField() が通る。
        // Phase 4.16: 全体の affectedKeys を `memberUids` / `organizerUids` / `memberDisplayNames`
        //   のみに限定（脱退時の同時 audioSettings / finishedTournamentCount 改竄を阻止）。
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'organizerUids', 'memberDisplayNames'])
        && request.auth.uid in resource.data.memberUids
        && !(request.auth.uid in resource.data.ownerUids)
        && !(request.auth.uid in request.resource.data.memberUids)
        && !(request.auth.uid in request.resource.data.organizerUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && (
          (
            request.auth.uid in resource.data.organizerUids
            && request.resource.data.organizerUids.size() == resource.data.organizerUids.size() - 1
            && resource.data.organizerUids.hasAll(request.resource.data.organizerUids)
          )
          ||
          (
            !(request.auth.uid in resource.data.organizerUids)
            && request.resource.data.organizerUids == resource.data.organizerUids
          )
        )
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('joinCodeId', null) == resource.data.get('joinCodeId', null)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
      ) || (
        // Phase 4.7: self-key displayName update — 既メンバーが自分の memberDisplayNames entry を更新。
        //   他フィールドは全て immutable にチェックし、map の差分は auth.uid キーに限定する。
        //   値は 1〜15 文字の string に制限（self-add と同じ）。
        //   両辺 .get(..., {}) で legacy doc 互換。
        // Phase 4.16: 全体の affectedKeys を `memberDisplayNames` のみに限定する。これがないと、
        //   memberDisplayNames を no-op にしつつ audioSettings / finishedTournamentCount などの
        //   他フィールドを member 権限で改竄できてしまう（emulator validation で検出）。
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberDisplayNames'])
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.organizerUids == resource.data.organizerUids
        && request.resource.data.ownerUids == resource.data.ownerUids
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('joinCodeId', null) == resource.data.get('joinCodeId', null)
        && request.resource.data.get('memberDisplayNames', {})
             .diff(resource.data.get('memberDisplayNames', {}))
             .affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberDisplayNames[request.auth.uid] is string
        && request.resource.data.memberDisplayNames[request.auth.uid].size() >= 1
        && request.resource.data.memberDisplayNames[request.auth.uid].size() <= 15
      ) || (
        // Phase 4.9: organizer による audioSettings 単独書換。
        //   audioSettings 以外のフィールド差分を一切許可しない（affectedKeys で atomic 強制）。
        //   audioSettings は map であることのみ rule で要求し、値の field-level validation
        //   （enabled bool / volume range / soundId string）は application 層 (zod) に委譲する。
        //   isOrganizer は既存 helper を再利用（owner も organizer に含まれる）。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audioSettings'])
        && request.resource.data.audioSettings is map
      ) || (
        // Phase 4.16: organizer による finishedTournamentCount の任意の非負整数値書換。
        //   2 経路で発火:
        //     (1) finishTournament() の runTransaction で `increment(1)`（旧値+1、二重 increment race を tx で防止）
        //     (2) サークル詳細画面 inline edit で任意の非負整数値（手動補正）
        //   どちらも affectedKeys は 'finishedTournamentCount' のみに限定。他フィールドは触らせない。
        //   `+1 限定` にせず `>= 0 の int` まで広げているのは (2) の手動補正用途を rule 側で塞がないため。
        //   organizer は元々サークルの全 CRUD を持つ信頼ロールのため、空値書込のリスクは許容範囲。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['finishedTournamentCount'])
        && request.resource.data.finishedTournamentCount is int
        && request.resource.data.finishedTournamentCount >= 0
      ) || (
        // Phase 4.17: organizer による defaultSeatsPerTable の単独書換。
        //   サークル詳細画面 inline edit から `setDefaultSeatsPerTable({ gid, uid, value })` 経由で発火。
        //   affectedKeys は 'defaultSeatsPerTable' のみに限定。他フィールドは触らせない。
        //   値域 2..10 は src/lib/firebase/schemas/tournament.ts の seatsPerTable.min(2).max(10) と
        //   厳密一致させる（DRIFT WARNING: tournaments seatsPerTable / players seatNum 上限 10 と連動。
        //   同時に変更すること）。
        //   organizer は元々サークルの全 CRUD を持つ信頼ロールのため、空値書込のリスクは許容範囲。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['defaultSeatsPerTable'])
        && request.resource.data.defaultSeatsPerTable is int
        && request.resource.data.defaultSeatsPerTable >= 2
        && request.resource.data.defaultSeatsPerTable <= 10
      ) || (
        // Phase A: organizer による seasonStartDate の単独書換。
        //   `startNewSeason()` の runTransaction で `seasonStartDate = serverTimestamp()` 経由で発火。
        //   affectedKeys は 'seasonStartDate' のみに限定。他フィールドは触らせない。
        //   Timestamp 型のみ強制（null セットは startNewSeason では発火させず、
        //   owner branch のフルアクセス経由でのみ可能）。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seasonStartDate'])
        && request.resource.data.seasonStartDate is timestamp
      ) || (
        // Phase C / 02-02: organizer による defaultTableLabels + defaultTableColors の atomic 書換。
        //   サークル詳細画面 inline edit から `setDefaultTableSettings({ gid, uid, labels, colors })` 経由で発火。
        //   affectedKeys は 'defaultTableLabels' / 'defaultTableColors' のみに限定。他フィールドは触らせない。
        //   双方とも list 型 + 最大 6 件（MAX_TABLES）を rule で強制。
        //   各要素の string 長 (label 1〜10 文字) と hex 形式 (color #RRGGBB) は Cloud Firestore Rules の
        //   言語仕様で list 内の element validate を表現できないため、application 層 (zod / service) に委譲する。
        //   organizer は元々サークルの全 CRUD を持つ信頼ロールのため、空値書込のリスクは許容範囲。
        //   labels と colors の長さ一致は service-side invariant（rule では検査しない）。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['defaultTableLabels', 'defaultTableColors'])
        && request.resource.data.defaultTableLabels is list
        && request.resource.data.defaultTableLabels.size() <= 6
        && request.resource.data.defaultTableColors is list
        && request.resource.data.defaultTableColors.size() <= 6
      ) || (
        // Phase E: organizer による seasonPointsRule の単独書換。
        //   サークル詳細画面の SeasonPointsRuleCard inline edit から
        //   `setSeasonPointsRule({ gid, uid, value })` 経由で発火。
        //   affectedKeys は 'seasonPointsRule' のみに限定。他フィールドは触らせない。
        //   null セット（既定値リセット）も同 branch で許可。
        //   値域: base は list 長 1..9 / baseline は int 2..10。
        //   各要素 (base[i] >= 0 number) は Cloud Firestore Rules で list element の値域を
        //   表現できないため schema / service 層に委譲する（最終ライン防御）。
        //   ⚠ DRIFT WARNING: base.size() <= 9 / baseline 2..10 のリテラルは
        //     src/lib/limits.ts の SEASON_POINTS_BASE_MAX_LENGTH / MIN_SEATS_PER_TABLE /
        //     MAX_SEATS_PER_TABLE と連動。drift 検出は scripts/test-rules-limits.mjs。
        //   organizer は元々サークルの全 CRUD を持つ信頼ロールのため、空値書込のリスクは許容範囲。
        isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seasonPointsRule'])
        && (
          request.resource.data.seasonPointsRule == null
          || (
            request.resource.data.seasonPointsRule is map
            && request.resource.data.seasonPointsRule.base is list
            && request.resource.data.seasonPointsRule.base.size() >= 1
            && request.resource.data.seasonPointsRule.base.size() <= 9
            && request.resource.data.seasonPointsRule.baseline is int
            && request.resource.data.seasonPointsRule.baseline >= 2
            && request.resource.data.seasonPointsRule.baseline <= 10
          )
        )
      );

      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.ownerUids;

      // Phase A: groups/{gid}/seasonStats/{uid}
      //   - 読取: group メンバー全員（owner / organizer / member）
      //   - 書込: organizer のみ（finishTournament tx と startNewSeason tx の 2 経路で発火）
      //   - invariants: docId == uid フィールド一致 / 数値の非負 / displayName 1〜15 文字
      //   - 値域・型は zod schema にも委譲し、rule 側は最低限の防御を担う
      match /seasonStats/{uid} {
        allow read: if isGroupMember(gid);
        allow create, update: if isOrganizer(gid)
                              && request.resource.data.uid == uid
                              && request.resource.data.participations is int
                              && request.resource.data.participations >= 0
                              && request.resource.data.wins is int
                              && request.resource.data.wins >= 0
                              && request.resource.data.finalTables is int
                              && request.resource.data.finalTables >= 0
                              && request.resource.data.totalPoints is number
                              && request.resource.data.totalPoints >= 0
                              && request.resource.data.displayName is string
                              && request.resource.data.displayName.size() >= 1
                              && request.resource.data.displayName.size() <= 15
                              && request.resource.data.lastUpdatedAt is timestamp;
        // startNewSeason の reset 経路で全件 delete するため organizer に許可。
        allow delete: if isOrganizer(gid);
      }

      // Phase A: groups/{gid}/seasonHistory/{seasonId}
      //   - 読取: group メンバー全員
      //   - 作成: organizer のみ（startNewSeason tx の append 経路）
      //   - 更新・削除: 禁止（履歴改竄を rule 側で deny、append-only）
      match /seasonHistory/{seasonId} {
        allow read: if isGroupMember(gid);
        allow create: if isOrganizer(gid)
                      && request.resource.data.endedAt is timestamp
                      && request.resource.data.entries is list;
        allow update, delete: if false;
      }
    }

    // groupJoinCodes: コード文字列を知るユーザーが `get` できる前提（URL 踏み経由の加入）。
    // Phase 4.6.1: `list` は明示的に禁止する。認証済みの任意ユーザーが全コード・全 gid を
    // 列挙できると、gid ベースの攻撃（groups self-add への不正加入）が trivial になる。
    // create は organizer のみ。update は usesCount を +1 する形のみ。
    match /groupJoinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.usesCount == 0
                    && isOrganizer(request.resource.data.gid);

      allow update: if isSignedIn()
                    && request.resource.data.gid == resource.data.gid
                    && request.resource.data.createdByUid == resource.data.createdByUid
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.maxUses == resource.data.maxUses
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.usesCount == resource.data.usesCount + 1
                    && resource.data.expiresAt.toMillis() > request.time.toMillis()
                    && (resource.data.maxUses == null
                        || request.resource.data.usesCount <= resource.data.maxUses);

      allow delete: if isSignedIn()
                    && isOwner(resource.data.gid);
    }

    // structures: read は group メンバー、write は organizer のみ
    match /structures/{sid} {
      allow read: if isGroupMember(resource.data.groupId);
      allow update, delete: if isOrganizer(resource.data.groupId);
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isOrganizer(request.resource.data.groupId);
    }

    // Phase 4.8: サークル横断のストラクチャテンプレート。
    // read / create は通常アカウントのみ（匿名除外）— description に機密が載る運用で
    // 匿名 SDK 直叩きによるリークを塞ぐため。UI は RequireAuth(allowAnonymous=false) で
    // 同じ gate をかけているが、rule で二重防御する。
    // update は本人のみ、delete は本人またはテンプレート管理者（`templateAdmins/{uid}` 存在）。
    //
    // ⚠ DRIFT WARNING (L-1): string フィールドの size() 上限は以下の schema と同期:
    //   - createdByDisplayName: <= 15 ↔ DISPLAY_NAME_MAX_LENGTH in schemas/group.ts
    //   - description: <= 200 ↔ structureTemplateBodySchema.description.max(200) in schemas/structureTemplate.ts
    //   schema を緩めるときは rule も同時に緩めること（逆も同様）。
    //   size() cap がないと SDK 直叩きで Firestore 1 doc 上限（~1MiB）まで膨らませられる。
    match /structureTemplates/{tid} {
      allow read: if isSignedInNotAnon();
      allow create: if isSignedInNotAnon()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.createdByDisplayName is string
                    && request.resource.data.createdByDisplayName.size() >= 1
                    && request.resource.data.createdByDisplayName.size() <= 15
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 200;
      // 編集は本人のみ。createdByUid / createdByDisplayName / createdAt は immutable。
      // 匿名で create できない前提なので、ここは isSignedIn() で足りる（本人 uid 一致が効く）。
      // description は update で変更可だが、create と同じ size() 上限を再強制する。
      allow update: if isSignedIn()
                    && resource.data.createdByUid == request.auth.uid
                    && request.resource.data.createdByUid == resource.data.createdByUid
                    && request.resource.data.createdByDisplayName == resource.data.createdByDisplayName
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 200;
      // 削除は本人または管理者。管理者 doc は console seed 起点のため匿名経路はない。
      allow delete: if isSignedIn()
                    && (resource.data.createdByUid == request.auth.uid || isTemplateAdmin());
    }

    // Phase 4.8: テンプレート管理者マーカー。doc 存在 = 管理者。
    // list 禁止（管理者 uid 列挙防止、security.md の groupJoinCodes と同方針）。
    // get は self のみ（自身が管理者かの確認）。
    // create/delete は既存管理者のみ（bootstrap は Firestore Console で手動 seed）。
    match /templateAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, delete: if isTemplateAdmin();
      allow update: if false;
    }

    // tournaments: read は認証済み（受付参加者向け）／write は organizer のみ
    match /tournaments/{tid} {
      // Phase 1 (04-spectate-mode): 観戦モード公開時は unauthenticated **get** を許可する。
      //   `allow read` 複合形のままだと anon が `where("spectateEnabled", "==", true)` で公開中の
      //   全 tournament を列挙できる discovery 経路が成立する（PRD「tid は base62 ≈ 117bit で
      //   推測困難」は GET の推測困難性であり、LIST 経由 discovery には効かない）。
      //   `groupJoinCodes` と同方針（`allow get` + `allow list: if false`）で明示分割し、
      //   anon に対する collection 列挙経路を defense-in-depth で塞ぐ。
      //   field 自体が無い旧 doc は `.get('spectateEnabled', false)` で false 扱い。
      allow get: if isSignedIn()
                 || resource.data.get('spectateEnabled', false) == true;
      // 既存の signed-in 経由 list（`listTournamentsByGroup` などの `where("groupId","==",gid)`）
      // は維持。anon の collection 列挙のみ deny。
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isOrganizer(request.resource.data.groupId);
      // tournaments update: organizer は全フィールド update 可（structure 編集 / level 進行 / state 遷移 /
      // spectateEnabled toggle 等）。
      //
      // Phase 1 (04-spectate-mode) では「spectateEnabled + updatedAt の単独書換 + is bool」の narrow 分岐 B
      // を OR で明示していたが、両分岐とも `isOrganizer(resource.data.groupId)` を要求していたため
      // 分岐 B は分岐 A の strict subset で permissions を一切追加しない dead branch だった
      // (architect-refactor 20260510)。
      //
      // 将来 spectateEnabled の toggle を非 organizer に開放する場合や `affectedKeys` を狭めて
      // narrow update path を本当に必要とするなら、その時点で分岐 A の `isOrganizer` を狭めると同時に
      // narrow 分岐を追加する形で導入する。`spectateEnabled is bool` の型強制は
      // `tournaments` zod schema が同じ制約を application 層で enforce 済み。
      allow update: if isOrganizer(resource.data.groupId);
      allow delete: if isOrganizer(resource.data.groupId);

      // 参加者ドキュメント: 本人による自己作成／更新／取消を許容（Phase 2: 受付フロー）
      // Phase 4: update を「self: displayName のみ変更可」と「organizer: bust/seat 変更可」に分岐。
      // Phase 4.6: organizer 経路は isOrganizer に強化（一般メンバーは他人を bust/seat できない）。
      match /players/{pid} {
        // Phase 1 (04-spectate-mode): 親 tournament が観戦モード公開中なら unauthenticated read 可。
        //   exists() ガードを必ず併用（外部 doc 参照規約）。
        //   .get('spectateEnabled', false) で field 未保有の旧 doc を false として評価。
        allow read: if isSignedIn()
                    || (
                      exists(/databases/$(database)/documents/tournaments/$(tid))
                      && get(/databases/$(database)/documents/tournaments/$(tid))
                           .data.get('spectateEnabled', false) == true
                    );
        // Phase 5.1: isPlayingDealer は create 時 false 固定（self-stamp PD 防止）。
        //   self-update 分岐で immutable 強制されているため、create を抜け道にされると
        //   組織者の同卓 1 PD 制約 (orchestrator.setIsPlayingDealer の tx) を bypass され
        //   `commitInitialSeating` が `TooManyPlayingDealersError` で詰まる DoS を許してしまう。
        //   `.get(..., false)` で field 未送信の legacy client も互換に通す。
        //
        // Phase 5.4: organizer による「同じ参加者で次のトーナメントを作成」用 clone 経路を additive 追加。
        //   - 親 tournament が exists かつ state==="setup" のときのみ
        //   - groupId の組織者のみ
        //   - pid == uid invariant・isBusted=false / no seat / no PD は self ブランチと同じ invariant
        //   - 件数上限（writeBatch サイズ）は rule で表現できないため client/repository 側 (MAX_CLONE_PLAYERS) で enforce
        // ⚠ DRIFT WARNING: 本ブランチの invariant は self-create / self-update と同期更新すること。
        //   players schema (`schemas/player.ts`) に新フィールドを追加する場合は両ブランチに反映する。
        allow create: if isSignedIn()
                      && (
                        (
                          pid == request.auth.uid
                          && request.resource.data.uid == request.auth.uid
                          && request.resource.data.isBusted == false
                          && request.resource.data.tableNum == null
                          && request.resource.data.seatNum == null
                          && request.resource.data.get('isPlayingDealer', false) == false
                        )
                        ||
                        (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                          && get(/databases/$(database)/documents/tournaments/$(tid)).data.state == "setup"
                          && pid == request.resource.data.uid
                          && request.resource.data.uid is string
                          && request.resource.data.isBusted == false
                          && request.resource.data.tableNum == null
                          && request.resource.data.seatNum == null
                          && request.resource.data.get('isPlayingDealer', false) == false
                        )
                      );
        // self-update: displayName のみ変更可。残りフィールドは immutable。
        // organizer-update: organizer なら bust/seat/lastMovedAt 変更可。uid と entryAt は immutable。
        // Phase 4 (M1 fix): organizer 経路でも tableNum / seatNum の型・範囲・整合性を rule で検証する。
        //   - 数値の場合は int 型 + 1〜MAX_TABLES (6) / 1〜MAX_SEATS_PER_TABLE (10) 範囲
        //   - tableNum と seatNum は同時 null か同時 int でなければならない（片方だけ設定不可）
        //
        // ⚠ DRIFT WARNING (L3): 以下の定数は rule 内ハードコード。drift を防ぐため、変更時は同期更新すること:
        //   - MAX_TABLES = 6 ↔ src/lib/services/seating/engine.ts の MAX_TABLES
        //   - MAX_SEATS_PER_TABLE = 10 ↔ src/lib/firebase/schemas/tournament.ts の seatsPerTable.max(10)
        // Cloud Functions 化（Phase 5+）で集約する場合はこの分散ロジックを廃止する。
        allow update: if isSignedIn()
                      && (
                        (
                          pid == request.auth.uid
                          && resource.data.uid == request.auth.uid
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.isBusted == resource.data.isBusted
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.bustedAt == resource.data.bustedAt
                          && request.resource.data.tableNum == resource.data.tableNum
                          && request.resource.data.seatNum == resource.data.seatNum
                          && request.resource.data.lastMovedAt == resource.data.lastMovedAt
                          // Phase 5.1: self 経路では isPlayingDealer も immutable に固定。
                          //   旧 doc（フィールド未保有）でも .get(..., false) で legacy 互換。
                          && request.resource.data.get('isPlayingDealer', false)
                              == resource.data.get('isPlayingDealer', false)
                        )
                        ||
                        (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                          && request.resource.data.uid == resource.data.uid
                          && request.resource.data.entryAt == resource.data.entryAt
                          && request.resource.data.isBusted is bool
                          && (
                            request.resource.data.tableNum == null
                            || (request.resource.data.tableNum is int
                                && request.resource.data.tableNum >= 1
                                && request.resource.data.tableNum <= 6)
                          )
                          && (
                            request.resource.data.seatNum == null
                            || (request.resource.data.seatNum is int
                                && request.resource.data.seatNum >= 1
                                && request.resource.data.seatNum <= 10)
                          )
                          && (
                            (request.resource.data.tableNum == null && request.resource.data.seatNum == null)
                            || (request.resource.data.tableNum != null && request.resource.data.seatNum != null)
                          )
                          // Phase 5.1: organizer 経路は isPlayingDealer を bool 型に限定
                          //   (additive: 旧 doc が field 未保有でも default false で hydrate 済み前提)。
                          && request.resource.data.get('isPlayingDealer', false) is bool
                        )
                      );
        // self-delete（自己取消）と organizer による owner-delete を許容。
        allow delete: if isSignedIn()
                      && (
                        pid == request.auth.uid
                        || (
                          exists(/databases/$(database)/documents/tournaments/$(tid))
                          && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                        )
                      );
      }

      // tables: organizer のみ書込可、認証済みユーザーは読取可。
      //
      // Phase 5.4: 旧 `match /{sub=**}` 再帰ワイルドカードはここを覆っていたが、
      // **同時に `/players/{pid}` も match してしまい** (Firestore Rules は OR 評価のため)、
      // explicit な `match /players/{pid}` 側の create / update invariants
      // (Phase 4 organizer-update の table/seat 範囲、Phase 5.1 の isPlayingDealer 型、
      // Phase 5.4 の organizer-clone branch 等) を**全て bypass する pre-existing 重大バグ**だった。
      // emulator validator [scripts/test-rules-clone-players.mjs](../scripts/test-rules-clone-players.mjs)
      // のケース 3〜6 が deny を期待して 200 を返していたのが本症状。
      //
      // 修正: wildcard を廃止し、実在する subcollection のみに explicit rule を当てる。
      // 現状の subcollection は `players` と `tables` の 2 つだけ
      // （PRD で言及されている `events` は未実装、`tables/{n}/seats/{m}` も未実装で
      // tableNum/seatNum は player doc に inline）。新規 subcollection を増やす場合は
      // **必ず explicit rule を 1 つ追加** すること（wildcard 復活は厳禁）。
      //
      // Phase C: 旧 `allow write` を `allow create / update` に分割し、update branch を
      // 「label / color に触らない経路」と「label / color のみを単独で書換える inline edit 経路」の
      // 2 ブランチで OR 表現する。前者は `commitInitialSeating` の tx.update（label 補完経路）
      // と将来的な isBroken 単独書換、後者は dashboard SeatingBoard の `✎` ボタンから発火する
      // `updateTableLabel(tid, tableNum, { label, color })` を想定。
      // 値域: label は 1〜TABLE_LABEL_MAX_LENGTH (= 10) 文字、color は #RRGGBB hex。
      // ⚠ DRIFT WARNING: TABLE_LABEL_MAX_LENGTH は src/lib/limits.ts の同名定数と一致させる。
      //   drift 検出は `scripts/test-rules-limits.mjs`（`npm run test:rules-limits`）で機械的に行う。
      match /tables/{tableId} {
        // Phase 1 (04-spectate-mode): 親 tournament が観戦モード公開中なら unauthenticated read 可。
        //   players と同型。exists() ガードを必ず併用。
        allow read: if isSignedIn()
                    || (
                      exists(/databases/$(database)/documents/tournaments/$(tid))
                      && get(/databases/$(database)/documents/tournaments/$(tid))
                           .data.get('spectateEnabled', false) == true
                    );
        allow create: if isSignedIn()
                      && exists(/databases/$(database)/documents/tournaments/$(tid))
                      && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId);
        allow update: if isSignedIn()
                      && exists(/databases/$(database)/documents/tournaments/$(tid))
                      && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId)
                      && (
                        // 経路 A: label / color に触れない既存 update（isBroken 単独書換 / commitInitialSeating の label 補完経路は経路 B 側で扱う）
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['label', 'color'])
                        ||
                        (
                          // 経路 B: label / color の単独書換（dashboard inline edit + 補完経路）
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['label', 'color'])
                          && (
                            request.resource.data.get('label', null) == null
                            || (
                              request.resource.data.label is string
                              && request.resource.data.label.size() >= 1
                              && request.resource.data.label.size() <= 10
                            )
                          )
                          && (
                            request.resource.data.get('color', null) == null
                            || (
                              request.resource.data.color is string
                              && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
                            )
                          )
                        )
                      );
        allow delete: if isSignedIn()
                      && exists(/databases/$(database)/documents/tournaments/$(tid))
                      && isOrganizer(get(/databases/$(database)/documents/tournaments/$(tid)).data.groupId);
      }
    }

    // Phase 5.1 追加: collectionGroup("players") query を許可するための path-wildcard rule。
    //   Firestore の collectionGroup query は path-specific rule
    //   （match /tournaments/{tid}/players/{pid}）では deny 扱いになるため、
    //   `match /{path=**}/players/{pid}` で recursive wildcard 経路を明示する。
    //   これがないと `subscribePlayersByUid`（JoinedTournamentsNav）が silent に
    //   空集合を返し、サイドバーの「参加中のトーナメント」が永遠に出ない。
    //   write は path-specific rule 側に集約しており、ここでは read だけを開ける。
    //   `players` collection-id は tournaments 配下にしか存在しないため副作用なし。
    match /{path=**}/players/{pid} {
      allow read: if isSignedIn();
    }
  }
}
